{
  "$schema": "kcrypto.qemu-demo.topology/v1",
  "campaign": "kcrypto-demo-qemu",
  "note": "Static D01-D08 topology: workloads, limits and expected evidence. The frozen run manifest (inputs/v1) copies these cells and binds the exact product/QEMU/image hashes before the first boot; paired observed/unobserved repetitions, multi-boot portions and the D08 reboot matrix extend this base list in later attempts.",
  "budgets": {"ordinary_s": 180, "boot_s": 300, "soak_s": 1500},
  "cells": [
    {
      "id": "T01-harness",
      "title": "owned cold boot, no observer, no workload",
      "image": "img-7014-base",
      "workload": {"kind": "cold-boot-no-observer"},
      "limits": {"timeout_s": 180},
      "expected_evidence": ["spawn.json", "console.log", "stop.json"]
    },
    {
      "id": "D01",
      "title": "available vs selected provider",
      "image": "img-7014-base",
      "workload": {"kind": "provider-selection", "requests": 300, "block_bytes": 4096, "rate_per_s": 10},
      "limits": {"timeout_s": 180},
      "expected_evidence": ["workload-ledger.jsonl", "registry.json", "product-report.json", "cell-D01.json"]
    },
    {
      "id": "D02",
      "title": "CPU/software alternative + retained handle",
      "image": "img-7014-nocrypto",
      "workload": {"kind": "cpu-variant", "requests": 300, "block_bytes": 4096, "rate_per_s": 10, "retained_control": true},
      "limits": {"timeout_s": 180},
      "expected_evidence": ["workload-ledger.jsonl", "registry.json", "handles.json", "product-report.json", "cpu-flags.txt", "cell-D02.json"]
    },
    {
      "id": "D03",
      "title": "real encrypted disk with independent readback",
      "image": "img-7014-base",
      "workload": {"kind": "dmcrypt-io", "bytes_each_direction": 67108864, "block_bytes": 4096, "needs_data_disk": true},
      "limits": {"timeout_s": 180},
      "expected_evidence": ["io-ledger.json", "product-report.json", "cell-D03.json"]
    },
    {
      "id": "D04",
      "title": "virtual crypto device path (one device)",
      "image": "img-7014-1crypt",
      "workload": {"kind": "virtio-device", "devices": 1, "control_ops": 50, "virtio_ops": 50},
      "limits": {"timeout_s": 180},
      "expected_evidence": ["device-ledger.json", "queue-reference.json", "product-report.json", "cell-D04.json"]
    },
    {
      "id": "D05",
      "title": "loss of a device (quiesced removal)",
      "image": "img-7014-1crypt",
      "workload": {"kind": "device-removal", "mode": "quiesced", "post_ops": 10},
      "limits": {"timeout_s": 180},
      "expected_evidence": ["removal-ledger.json", "qmp-events.jsonl", "cell-D05.json"]
    },
    {
      "id": "D06",
      "title": "within-request fallback (X01 controlled fixture)",
      "image": "img-7014-base",
      "workload": {"kind": "nested-fallback", "sizes": [512, 1024, 4096], "ops_per_size": 100},
      "limits": {"timeout_s": 180},
      "expected_evidence": ["cell-D06.json"]
    },
    {
      "id": "D07",
      "title": "cold boot with early observer",
      "image": "img-7014-base",
      "workload": {"kind": "early-boot", "observer": "early", "io_bytes": 16777216, "needs_data_disk": true},
      "limits": {"timeout_s": 300},
      "expected_evidence": ["attach-ready.json", "io-ledger.json", "product-report.json", "cell-D07.json"]
    },
    {
      "id": "D08",
      "title": "stop and slower stability (20-minute soak)",
      "image": "img-7014-base",
      "workload": {"kind": "stop-soak", "aggregate_minutes": 20, "windows": 20, "window_ops": 600},
      "limits": {"timeout_s": 1500},
      "expected_evidence": ["workload-ledger.jsonl", "soak-windows.json", "stop-receipt.json", "product-report.json", "cell-D08.json"]
    }
  ]
}

  "equivalence": {
    "flat_afalg": "7.x: product enc == dec == driver ops_total, alloc == 1, destroy_skip == 1, errors == 0, queued == 0",
    "floor_afalg": "6.12: per (op, arm in {cbc-aes-aesni, __cbc-aes-aesni}) calls == ops_total; alloc rows exactly [cbc(aes), cryptd(__cbc-aes-aesni)] each == 1; predrop_destroy_skip == 3 (R1 pinned in advance: P9 sealed 10/10 + floor-rejudge verified; nested route destroys 3 transforms per socket-close)",
    "async": "enc calls == queued == GOs, ok == 0 (EINPROGRESS), alloc == GOs, destroy_skip == GOs",
    "details_clean": "truncated == false, loss keys subset of {adapter.tombstone_evictions} (R1 tombstone-tolerant: FIFO maintenance tolerated and recorded, never silent), observations == expected calls, emitted == admitted, unfinished == 0 (sync classes)",
    "details_async": "envelope-only: terminals unknown, unfinished == GOs",
    "details_truncated": "truncated flag or emitted >= cap with emitted < offered: envelope data point, never a valid pair leg"
  },

{
  "$schema": "kryprobe-perf-campaign/v1",
  "campaign": "kcrypto-t14",
  "manifest_version": 1,
  "frozen_utc": "DRAFT-R1-UNFROZEN",
  "freeze_rule": "R1 DRAFT (v3 content): freezes before the first R1 sampling boot; any stimulus/mode/equivalence/validity edit after the freeze stamp invalidates sealed receipts. P9 v2 stamp was 2026-09-29T10:55:00Z (T14 sealed campaign).",
  "budgets": {
    "B1_throughput_ratio_min": 0.95,
    "B2_p99_ratio_max": 1.1,
    "applies": "qualified flat-out 4 KiB / 1 MiB aggregate pair-sets on supported kernels (7.0.14, 7.2.6); floor and paced sets publish envelopes",
    "verdict": "median inside AND >=80% of pairs inside => PASS; median outside AND >=80% outside => FAIL; else INCONCLUSIVE (see docs/bench-thresholds.md)"
  },
  "global": {
    "kernels": [
      "6.12.111",
      "7.0.14",
      "7.2.6"
    ],
    "vng": {
      "6.12.111": "v6.12.111",
      "7.0.14": "v7.0.14",
      "7.2.6": "v7.2.6"
    },
    "warmup_s": 10,
    "measure_s": 30,
    "capture_s": 50,
    "settle_s": 5,
    "quiet_s": 5,
    "pairs_per_set": 5,
    "max_attempted_pairs": 8,
    "guest_cpus": 4,
    "guest_memory": "4G",
    "detail_cap": 100000,
    "paced_rate_per_s": 1000,
    "paced_late_max_frac": 0.01
  },
  "classes": {
    "P-64": {
      "title": "64 B skcipher roundtrips (AF_ALG cbc(aes))",
      "driver": "skcipher",
      "size": 64
    },
    "P-4K": {
      "title": "4 KiB skcipher roundtrips (AF_ALG cbc(aes))",
      "driver": "skcipher",
      "size": 4096
    },
    "P-1M": {
      "title": "1 MiB skcipher roundtrips (AF_ALG cbc(aes))",
      "driver": "skcipher",
      "size": 1048576
    },
    "P-AEAD": {
      "title": "high-rate AEAD roundtrips (AF_ALG gcm(aes), 1024 B + 32 B assoc + 16 B tag)",
      "driver": "aead",
      "size": 1024,
      "assoc": 32,
      "tag": 16
    },
    "P-ASYNC": {
      "title": "deliberately asynchronous completion (fixture async-once GO loop)",
      "driver": "async",
      "size": 16
    }
  },
  "modes": {
    "disabled": {
      "title": "tracing disabled (no observer): baseline A of every pair"
    },
    "attached-idle": {
      "title": "observer attached, workload idle: footprint legs only, never a workload pair"
    },
    "aggregation": {
      "title": "api-returns capture during workload (report --system)",
      "profile": "api-returns"
    },
    "full-details": {
      "title": "request-lifecycle capture during workload (report --system --kcrypto-profile request-lifecycle)",
      "profile": "request-lifecycle"
    },
    "stack-sampling": {
      "status": "NOT_RUN",
      "reason": "no standalone product toggle: R1 stacks are first-seen-only attribution inside api-returns (lifecycle object captures no stacks); stack observables reported from aggregation who rows plus the diag-stack-7014 probe"
    }
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kryprobe:design:kcrypto-lifecycle:v1",
  "title": "KryProbe kcrypto lifecycle payload v1",
  "description": "Standalone report-JSON profile for one reduced kcrypto request lifecycle (schema kryprobe.kcrypto.lifecycle/v1). NOT carried in the v0 event envelope: event-v0 has no backend_payload property and forbids additional properties, so envelope carriage is deferred to a versioned envelope ADR (frozen v0 bytes are untouched). Draft: bytes freeze only after review (no compiled-in pin yet). Structural validation never establishes evidence truth; see docs/kcrypto-evidence.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kryprobe.kcrypto.lifecycle/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+(?![\\s\\S])",
      "maxLength": 96
    },
    "tfm_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+(?![\\s\\S])",
          "maxLength": 96
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "type": "string",
      "enum": [
        "sync",
        "callback",
        "unknown"
      ]
    },
    "status": {
      "description": "Exact native errno from the terminal edge (JSON integer, i32 range; zero-fraction numbers admitted per JSON Schema). Null if and only if terminal is unknown.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ns": {
      "description": "Submit-to-terminal-edge span as a canonical decimal u64 string (0..=18446744073709551615; the pattern and the validator both enforce the exact range). Null when either endpoint is missing; never zero-filled for unknown terminals.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18}|1(?:0[0-9]{18}|[1-7][0-9]{18}|8(?:(?:0[0-9]{17}|[1-3][0-9]{17}|4(?:(?:0[0-9]{16}|[1-3][0-9]{16}|4(?:(?:0[0-9]{15}|[1-5][0-9]{15}|6(?:(?:0[0-9]{14}|[1-6][0-9]{14}|7(?:(?:0[0-9]{13}|[1-3][0-9]{13}|4(?:(?:0[0-9]{12}|[1-3][0-9]{12}|4(?:0(?:0[0-9]{10}|[1-6][0-9]{10}|7(?:(?:0[0-9]{9}|[1-2][0-9]{9}|3(?:(?:0[0-9]{8}|[1-6][0-9]{8}|7(?:0(?:0[0-9]{6}|[1-8][0-9]{6}|9(?:(?:0[0-9]{5}|[1-4][0-9]{5}|5(?:(?:0[0-9]{4}|[1-4][0-9]{4}|5(?:(?:0[0-9]{3}|1(?:(?:0[0-9]{2}|[1-5][0-9]{2}|6(?:(?:0[0-9]|1(?:(?:0|[1-4]|5))))))))))))))))))))))))))))))))))(?![\\s\\S])",
          "maxLength": 20
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "request_id",
    "tfm_id",
    "terminal",
    "status",
    "duration_ns"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Terminal truth requires an exact native status; unknown terminals carry no status or duration.",
      "anyOf": [
        {
          "properties": {
            "terminal": {
              "enum": [
                "sync",
                "callback"
              ]
            },
            "status": {
              "type": "integer"
            }
          },
          "required": [
            "terminal",
            "status"
          ]
        },
        {
          "properties": {
            "terminal": {
              "const": "unknown"
            },
            "status": {
              "type": "null"
            },
            "duration_ns": {
              "type": "null"
            }
          },
          "required": [
            "terminal",
            "status",
            "duration_ns"
          ]
        }
      ]
    }
  ]
}

            "target_selector": {
              "type": "string",
              "enum": [
                "pid",
                "tree",
                "cgroup",
                "owned_run",
                "system"
              ]
            },
            "capture_mode": {
              "type": "string",
              "enum": [
                "inventory",
                "profile",
                "trace"
              ]
            },
            "requested_backends": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "p11",
                  "openssl",
                  "kcrypto"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "contract_version": {
              "const": "v0-proposed"
            },
            "qualification_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$",
              "maxLength": 96
            }

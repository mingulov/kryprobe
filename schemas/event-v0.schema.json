{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kryprobe:design:event:v0",
  "title": "KryProbe proposed event envelope v0",
  "description": "KryProbe proposed initial event envelope v0 for p11, openssl, and kcrypto. Design artifact, not implemented protocol. Structural validation never establishes evidence truth; see docs/CONTRACTS.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kryprobe.event/v0"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$",
      "maxLength": 96
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$",
      "maxLength": 96
    },
    "monotonic_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 24
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "kind",
    "session_id",
    "record_id",
    "monotonic_ns",
    "payload"
  ],
  "additionalProperties": false,
